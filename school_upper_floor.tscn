[sub_resource type="Shader" id="Shader_door_lit"]
code = "shader_type spatial;
render_mode cull_disabled;

uniform sampler2D door_texture : source_color, filter_nearest;

void fragment() {
	vec3 original = texture(door_texture, UV).rgb;
	ALBEDO = mix(sqrt(original), vec3(0.42, 0.25, 0.12), 0.14);
	ROUGHNESS = 0.86;
	NORMAL = FRONT_FACING ? NORMAL : -NORMAL;
}
"

