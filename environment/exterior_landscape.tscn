[sub_resource type="Shader" id="Shader_water"]
code = "shader_type spatial;\nrender_mode cull_disabled, diffuse_burley, specular_schlick_ggx;\nuniform vec4 deep_color : source_color = vec4(0.018, 0.075, 0.085, 1.0);\nuniform vec4 shallow_color : source_color = vec4(0.055, 0.145, 0.14, 1.0);\nvoid vertex() {\n\tVERTEX.y += sin(VERTEX.x * 1.7 + TIME * 0.75) * 0.018;\n\tVERTEX.y += cos(VERTEX.z * 3.1 - TIME * 0.58) * 0.012;\n}\nvoid fragment() {\n\tfloat ripple = sin(UV.x * 60.0 + TIME) * 0.5 + 0.5;\n\tALBEDO = mix(deep_color.rgb, shallow_color.rgb, ripple * 0.34);\n\tROUGHNESS = 0.24;\n\tSPECULAR = 0.72;\n}\n"

